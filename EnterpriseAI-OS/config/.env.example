# EnterpriseAI-OS Environment Configuration
# نسخ هذه الملف إلى .env وعدل القيم

# === Application ===
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=change-this-to-a-secure-random-string

# === Database ===
DATABASE_URL=postgresql://enterpriseai:secure_password@postgres:5432/enterpriseai
DB_PASSWORD=secure_password

# === Cache ===
REDIS_URL=redis://redis:6379/0

# === Analytics ===
CLICKHOUSE_URL=clickhouse://localhost:8123/enterpriseai

# === Message Broker ===
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# === AI ===
AI_GPU_ENABLED=false
AI_MODEL_PATH=/models

# === Security ===
JWT_SECRET=change-this-to-another-secure-random-string
ENCRYPTION_KEY=change-this-to-a-32-byte-encryption-key

# === Monitoring ===
PROMETHEUS_ENABLED=true
SENTRY_DSN=

# === Email ===
SMTP_HOST=smtp.company.com
SMTP_PORT=587
SMTP_USER=noreply@company.com
SMTP_PASSWORD=
